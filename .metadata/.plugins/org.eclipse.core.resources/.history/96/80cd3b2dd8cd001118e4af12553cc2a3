<%@ page contentType="text/html; charset=UTF-8"%>
<!DOCTYPE html>
<html lang="en">
<head>
<title>Bootstrap Example</title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
<script type="text/javascript">
	/*
	비동기 기술의 발전 순서
		1) XMLHttpRequest 직접 제어
		2) JQuery Ajax(외부 의존 라이브러리이므로 사용이 지양되고 있는 추세)
		3) Promise(브라우저 자체 지원 API)
		4) fetch(Promise 가 사용하기에 너무 코드량이 많고 복잡하므로 fetch 로 숨겨놓음)
		5) async/await
	*/
	
	function login(){
		/*
		Promise 란? 미래의 확정되지 않는 작업에 사용되는 비동기 처리 기술(웹 요청)
		화살표 함수의 매개변수
		변수 1) resolve 라는 이름의 함수명을 정함 - 비동기 요청이 성공하였을때 호출할 함수명
		변수 2) reject 라는 이름의 함수명을 정함 - 비동기 요청이 실패하였을때 호출할 함수명
		*/
		
		let promise = new Promise((resolve, reject)=>{
			
			//비동기 출발
			$.ajax({
				url:"/login",
				type:"POST",
				success:function(result, status, xhr){//2xx 성공의 상태 status 코드 서버로부터 받아올때
					resolve(result);
				},
				error:function(xhr, status, error){//3xx 이상의 문제가 생긴 status 코드를 서버로부터 받아올때
					reject(error);
				}
			});
		});//Promise 생성자의 닫는 소괄호
		return promise;
	}
	
	$(function(){
		$("#bt-login").click(()=>{
			login()
				.then((result)=>{
					console.log("로그인 성공 후 반환 데이터는", result);
					alert("로그인 성공");
					location.href="/spa/main";
				})//반환된 Promise의 then() 을 호출, then은 resolve() 호출시 호출 됨
				.catch();//반환된 Promise 에서 reject() 호출 시 catch()가 호출 됨
		});
	});
	
</script>
</head>
<body>

	<div class="container">
		<h2>로그인</h2>
		<form id="form1">
			<div class="form-group">
				<input type="text" class="form-control" placeholder="Enter Your Id" name="accountId">
			</div>
			
			<div class="form-group">
				<input type="password" class="form-control" id="pwd" placeholder="Enter password" name="pwd">
			</div>
			
			<button type="button" class="btn btn-primary" id="bt-login">Submit</button>
		</form>
	</div>

</body>
</html>
