<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hexagon.springmvc.mapper.JobMapper">
	<select id="select" parameterType="int" resultType="Job">
		select job_id ,job_code ,job_name ,is_active
		from job
		where job_id 
	</select>
</mapper>

