<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mappers.PermissionMapper">

	<!-- 특정 role에 소속된 permission 가져오기 -->
	<select id="selectByHrRoleId" parameterType="int" resultType="Permission">
		select * 
		from permission 
		where permission_id in (
			select permission 
			from hr_role_permission 	
			where hr_role_id=#{hrRoleId}
		)
	</select>
</mapper>