<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mappers.SubCategoryMapper">

	<select id="selectByTopCategoryId" parameterType="int" resultType="">
		select subcategory_id, sub_name
		from subcategory
		where topcategory_id=#{topcategory)id}
	</select>

</mapper>