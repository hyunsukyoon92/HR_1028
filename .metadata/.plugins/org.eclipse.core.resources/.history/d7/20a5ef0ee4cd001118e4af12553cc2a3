package com.hexagon.springmvc.security;

import java.util.Collection;
import java.util.Collections;

import org.springframework.security.core.GrantedAuthority;
import org.springframework.security.core.userdetails.UserDetails;

import com.hexagon.springmvc.domain.Admin;

//애플리케이션 마다 db상 아이디, 패스워드 등의 컬럼 명이 틀리기 때문에 스프링이 자동으로 인식 불가
//따라서 스프링 측에서 이미 정의해놓은 도메인 객체인 UserDetails 안에 우리의 Admin도메이 객체의 정보를 대입해놓아야 한다
public class AdminDetails implements UserDetails {

	// 사용자 정보를 낱개로 보유하지 않기 위해 Admin 통째로 보유하자!!
	private Admin admin;

	@Override
	public Collection<? extends GrantedAuthority> getAuthorities() {
		// TODO Auto-generated method stub
		return Collections.emptyList();//권한이 없더라도 null 로 놓으면 안되고, 그냥 객체는 존재시키되 한건도 없는 상태로 반환하면 됨
	}

	@Override
	public String getPassword() {
		// TODO Auto-generated method stub
		return null;
	}

	//스프링 시큐리티에서 말하는 username 이란 로그인아이디 임!!
	@Override
	public String getUsername() {
		// TODO Auto-generated method stub
		return admin.getLoginId();
	}

	@Override
	public boolean isAccountNonExpired() {
		// TODO Auto-generated method stub
		return false;
	}

	@Override
	public boolean isAccountNonLocked() {
		// TODO Auto-generated method stub
		return false;
	}

	@Override
	public boolean isCredentialsNonExpired() {
		// TODO Auto-generated method stub
		return false;
	}

	@Override
	public boolean isEnabled() {
		// TODO Auto-generated method stub
		return false;
	}
}
